# Airflow user (Linux). Find with: id -u
AIRFLOW_UID=50000

# Optional: override Airflow image
# AIRFLOW_IMAGE_NAME=apache/airflow:2.8.1

# Airflow admin (created on airflow-init)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# MinIO (S3 compatible) for ODS
REMANGA_MINIO_ENDPOINT=http://minio:9000
REMANGA_MINIO_ACCESS_KEY=minioadmin
REMANGA_MINIO_SECRET_KEY=minioadmin
REMANGA_MINIO_BUCKET=ods-remanga

